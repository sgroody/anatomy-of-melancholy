<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:ed="https://burton-edition.local/ns/gowland" xml:lang="en"><teiHeader><fileDesc><titleStmt><title>The Anatomy of Melancholy, dedication</title></titleStmt><publicationStmt><p>Generated by `burton ingest`. Do not edit by hand.</p></publicationStmt><sourceDesc><p>Gowland 2021 EPUB, sha256 a0e3641f336ac2085023b187302ef3522d2d814e50220ca39725653ee70be899, file preface002.xhtml</p></sourceDesc></fileDesc></teiHeader><text><body><div type="front" n="dedication" xml:id="udedication"><quote type="block" xml:lang="la" ana="foreign" resp="#editor" cert="high" xml:id="udedication-f1"><p rend="dedf" src="preface002.xhtml#nat0005334" xml:id="udedication-p1"><pb n="5" ed="penguin2021"/>HONORATISSI-</p>
<p rend="ded2" src="preface002.xhtml#nat0005335" xml:id="udedication-p2">MO DOMINO NON</p>
<p rend="ded4" src="preface002.xhtml#nat0005336" xml:id="udedication-p3">MINUS VIRTUTE SUA,</p>
<p rend="ded6" src="preface002.xhtml#nat0005337" xml:id="udedication-p4">Q<hi rend="sc">UAM GENERIS</hi></p>
<p rend="ded6" src="preface002.xhtml#nat0005338" xml:id="udedication-p5"><hi rend="sc">SPLENDORE,</hi></p>
<p rend="ded4" src="preface002.xhtml#nat0005339" xml:id="udedication-p6">ILLUSTRISSIMO,</p>
<p rend="ded1" src="preface002.xhtml#nat0005340" xml:id="udedication-p7">GEORGIO BERKLEIO,</p>
<p rend="ded4" src="preface002.xhtml#nat0005341" xml:id="udedication-p8">MILITI DE BALNEO,</p>
<p rend="ded6" src="preface002.xhtml#nat0005342" xml:id="udedication-p9"><hi rend="sc">BARONI DE BERKLEY</hi></p>
<p rend="ded6" src="preface002.xhtml#nat0005343" xml:id="udedication-p10"><hi rend="sc">MOUBREY, SEGRAVE,</hi></p>
<p rend="ded6" src="preface002.xhtml#nat0005344" xml:id="udedication-p11"><hi rend="sc">D. DE BRUSE,</hi></p>
<p rend="ded4" src="preface002.xhtml#nat0005345" xml:id="udedication-p12"><hi rend="i">DOMINO SUO</hi></p>
<p rend="ded6 TS1" src="preface002.xhtml#nat0005346" xml:id="udedication-p13"><hi rend="i">Multis Nominibus Observando,</hi></p>
<p rend="ded6 TS1" src="preface002.xhtml#nat0005347" xml:id="udedication-p14"><hi rend="sc">HANC SUAM</hi></p>
<p rend="ded4" src="preface002.xhtml#nat0005348" xml:id="udedication-p15">MELANCHOLIAE</p>
<p rend="ded4" src="preface002.xhtml#nat0005349" xml:id="udedication-p16">ANATOMEN,</p>
<p rend="ded6 TS1" src="preface002.xhtml#nat0005350" xml:id="udedication-p17"><hi rend="sc">JAM SEXTO</hi></p>
<p rend="ded6" src="preface002.xhtml#nat0005351" xml:id="udedication-p18"><hi rend="sc">REVISAM,</hi></p>
<p rend="ded6" src="preface002.xhtml#nat0005352" xml:id="udedication-p19"><hi rend="sc">D. D.</hi></p>
<p rend="ded4" src="preface002.xhtml#nat0005353" xml:id="udedication-p20">DEMOCRITUS Junior.</p>
</quote>
<ed:block><p rend="center_content TS1" src="preface002.xhtml#nat0005354" xml:id="udedication-p21">[Translation]</p>
<p rend="center_content TS1" src="preface002.xhtml#nat0005355" xml:id="udedication-p22">To the most honourable Lord, George Berkeley,</p>
<p rend="center_content" src="preface002.xhtml#nat0005356" xml:id="udedication-p23">Knight of the Bath, Baron Berkeley, Mowbray and Seagrave, Lord Breuse,</p>
<p rend="center_content" src="preface002.xhtml#nat0005357" xml:id="udedication-p24">most illustrious, no less for his own virtue</p>
<p rend="center_content" src="preface002.xhtml#nat0005358" xml:id="udedication-p25">than for the splendour of his family,</p>
<p rend="center_content" src="preface002.xhtml#nat0005359" xml:id="udedication-p26">to his Lord, to be esteemed for many reasons,</p>
<p rend="center_content" src="preface002.xhtml#nat0005360" xml:id="udedication-p27">Democritus Junior gives as a gift this his <hi rend="i">Anatomy of Melancholy</hi>,</p>
<p rend="center_content" src="preface002.xhtml#nat0005361" xml:id="udedication-p28">now revised for the sixth time.</p>
</ed:block>
</div></body></text></TEI>