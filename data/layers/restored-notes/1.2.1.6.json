      "in": "1.2.1.6-p2",
      "prefix": "he son, ",
      "suffix": " takes e"
    },
    "source": "Project Gutenberg #10800",
    "text": "Saepe non eundem, sed similem producit effectum, et illaeso parente transit. in nepotem."
  },
  "1.2.1.6-r5": {
    "by": "rules",
    "date": "2026-11-18",
