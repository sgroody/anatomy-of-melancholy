      "in": "1.2.1.6-p4",
      "prefix": ", 1551, ",
      "suffix": " went re"
    },
    "source": "Project Gutenberg #10800",
    "text": "Quasi mox in terram collapsurus, per omne vitam incedebat cum mater gravia ebrium hominem sic incedentem viderat."
  },
  "1.2.1.6-r8": {
    "by": "rules",
