      "in": "1.2.1.6-p3",
      "prefix": "son (as ",
      "suffix": " thinks)"
    },
    "source": "Project Gutenberg #10800",
    "text": "Coitus super repletionem pessimus, et filii qui tum gignuntur, aut morbosi sunt, aut stolidi."
  },
  "1.2.1.6-r6": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 1337,
    "selector": {
      "exact": "Cardan",
      "in": "1.2.1.6-p3",
      "prefix": " (saith ",
      "suffix": " subtil."
    },
    "source": "Project Gutenberg #10800",
    "text": "Nam spiritus cerebri si tum male afficiantur, tales procreant, et quales fuerint affectus, tales filiorum: ex tristibus tristes, ex jucundis jucundi nascuntur, &c."
  },
  "1.2.1.6-r7": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 1341,
    "selector": {
