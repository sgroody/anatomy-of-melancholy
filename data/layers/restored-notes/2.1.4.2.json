      "suffix": " take ph"
    },
    "source": "Project Gutenberg #10800",
    "text": "Non ad mensem aut annum, sed opportet toto vitae curriculo curationi operam dare."
  },
  "2.1.4.2-r12": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2880,
    "selector": {
      "exact": "that",
      "in": "2.1.4.2-p4",
      "prefix": "horis., ",
      "suffix": " without"
    },
    "source": "Project Gutenberg #10800",
    "text": "Operari ex libris, absque cognitione et solerti ingenio, periculosum est. Unde monemur, quam insipidum scriptis auctoribus credere, quod hic suo didicit periculo."
  },
  "2.1.4.2-r2": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2860,
