      "prefix": " would, ",
      "suffix": " the gol"
    },
    "source": "Project Gutenberg #10800",
    "text": "Quicquid auri apud nos est, libenter persolvemus, etiamsi tota urbs nostra aurum esset."
  },
  "2.1.4.2-r3": {
    "by": "rules",
    "date": "2026-11-18",
