      "prefix": "he had; ",
      "suffix": " because"
    },
    "source": "Project Gutenberg #10800",
    "text": "Felicior in medicina ob fidem Ethnicorum."
  },
  "2.1.4.2-r6": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2871,
    "selector": {
      "exact": "Seneca",
      "in": "2.1.4.2-p4",
      "prefix": "veat of ",
      "suffix": " to his "
    },
    "source": "Project Gutenberg #10800",
    "text": "Nihil ita sanitatem impedit, ac remediorum crebra mutatio, nec venit vulnus ad cicatricem in quo diversa medicamenta tentantur."
  },
  "2.1.4.2-r7": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2872,
    "selector": {
      "exact": "’Tis",
      "in": "2.1.4.2-p4",
      "prefix": " fault: ",
      "suffix": " proper "
    },
    "source": "Project Gutenberg #10800",
    "text": "Melancholicorum proprium, quum ex eorum arbitrio non fit subita mutatio in melius, alterare medicos qui quidvis, &c."
  },
  "2.1.4.2-r8": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2874,
    "selector": {
      "exact": "perseverance",
      "in": "2.1.4.2-p4",
      "prefix": "n hand, ",
      "suffix": " and suf"
    },
    "source": "Project Gutenberg #10800",
    "text": "Imprimis hoc statuere oportet, requiri perseverantiam, et tolerantiam. Exiguo enim tempore nihil ex, &c."
  },
  "2.1.4.2-r9": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 2875,
    "selector": {
      "exact": "if",
      "in": "2.1.4.2-p4",
      "prefix": "lls her ",
      "suffix": " she wil"
    },
    "source": "Project Gutenberg #10800",
    "text": "Si curari vult, opus est pertinaci perseverantia, fideli obedientia, et patientis singulari, si taedet aut desperet, nullum habebit effectum."
  }
