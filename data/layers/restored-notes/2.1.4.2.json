      "prefix": "d which ",
      "suffix": " notes, "
    },
    "source": "Project Gutenberg #10800",
    "text": "Melancholici plerumque medicis sunt molesti, ut alia aliis adjungant."
  },
  "2.1.4.2-r4": {
    "by": "rules",
    "date": "2026-11-18",
