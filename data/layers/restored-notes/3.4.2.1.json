      "in": "3.4.2.1-p9",
      "prefix": "se men, ",
      "suffix": " seem to"
    },
    "source": "Project Gutenberg #10800",
    "text": "Non minus hi furunt quam Hercules, qui conjugem et liberos interfecit; habet haec aetas plura hujusmodi portentosa monstra."
  },
  "3.4.2.1-r6": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6645,
    "selector": {
      "exact": "Thus",
      "in": "3.4.2.1-p10",
      "prefix": "texunt. ",
      "suffix": " they mu"
    },
    "source": "Project Gutenberg #10800",
    "text": "Oh! Jupiter, do you hear those things? Collecting many such facts, they weave a tissue of reproaches against God's providence."
  },
  "3.4.2.1-r7": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6650,
    "selector": {
