    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4471,
    "selector": {
      "exact": "thou",
      "in": "3.1.1.2-p3",
      "prefix": "li vis; ",
      "suffix": " wilt no"
    },
    "source": "Project Gutenberg #10800",
    "text": "Terram non vis malam, malam segetem, sed bonam arborem, equum bonum, &c."
  },
  "3.1.1.2-r7": {
    "by": "rules",
    "date": "2026-11-03",
