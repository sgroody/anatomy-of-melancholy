  "3.1.1.2-r4": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4469,
    "selector": {
      "exact": "Scaliger",
      "in": "3.1.1.2-p2",
      "prefix": "in joy. ",
      "suffix": " exerc. "
    },
    "source": "Project Gutenberg #10800",
    "text": "Non est amor desiderium aut appetitus ut ab omnibus hactenus traditim; nam cum potimur amata re, non manet appetitus; est igitur affectus quo cum re amata aut unimur, aut unionem perpetuamus."
  },
  "3.1.1.2-r5": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
