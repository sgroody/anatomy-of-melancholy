      "in": "3.1.1.2-p2",
      "prefix": "s good. ",
      "suffix": " wisheth"
    },
    "source": "Project Gutenberg #10800",
    "text": "Desiderium optantis, amor eorum quibus fruimur; amoris principium, desiderii finis, amatum adest."
  },
  "3.1.1.2-r20": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4487,
    "selector": {
      "exact": "God",
      "in": "3.1.1.2-p4",
      "prefix": "or ill: ",
      "suffix": ", our ne"
    },
    "source": "Project Gutenberg #10800",
    "text": "Tria sunt, quae amari a nobis bene vel male possunt; Deus, proximus, mundus; Deus supra nos; juxta nos proximus; infra nos mundus. Tria Deus, duo proximus, unum mundus habet, &c."
  },
  "3.1.1.2-r21": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4488,
    "selector": {
      "exact": "I",
      "in": "3.1.1.2-p4",
      "prefix": "t. 501) ",
      "suffix": " confoun"
    },
    "source": "Project Gutenberg #10800",
    "text": "Ne confundam vesanos et foedos amores beatis, sceleratum cum puro divino et vero, &c."
  },
  "3.1.1.2-r22": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
