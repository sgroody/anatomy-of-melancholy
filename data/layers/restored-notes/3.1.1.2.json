      "exact": "And",
      "in": "3.1.1.2-p3",
      "prefix": " to us. ",
      "suffix": " nothing"
    },
    "source": "Project Gutenberg #10800",
    "text": "Nihil hine magis animos conciliat quam musica, pulchrae, aedes, &c."
  },
  "3.1.1.2-r14": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4481,
    "selector": {
      "exact": "One",
      "in": "3.1.1.2-p3",
      "prefix": " loves. ",
      "suffix": " Venus i"
    },
    "source": "Project Gutenberg #10800",
    "text": "Duae Veneres duo amores; quarum una antiquior et sine matre, coelo nata, quam coelestem Venerem nuncupamus; altera vero junior a Jove et Dione prognata, quam vulgarem Venerem vocamus."
  },
  "3.1.1.2-r15": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4482,
    "selector": {
      "exact": "or",
      "in": "3.1.1.2-p3",
      "prefix": "Devils, ",
      "suffix": " good an"
    },
    "source": "Project Gutenberg #10800",
    "text": "Alter ad superna erigit, alter deprimit ad inferna."
  },
  "3.1.1.2-r16": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4483,
    "selector": {
      "exact": "The",
      "in": "3.1.1.2-p3",
      "prefix": " souls. ",
      "suffix": " one rea"
    },
    "source": "Project Gutenberg #10800",
    "text": "Alter excitat hominem ad divinam pulchritudinem lustrandam, cujus causa philosophiae studia et justitiae, &c."
  },
  "3.1.1.2-r17": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4484,
    "selector": {
      "exact": "Every",
      "in": "3.1.1.2-p3",
      "prefix": "effect. ",
      "suffix": " creatur"
    },
    "source": "Project Gutenberg #10800",
    "text": "Omnis creatura cum bona sit, et bene amari potest et male."
  },
  "3.1.1.2-r18": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4485,
    "selector": {
      "exact": "Two",
      "in": "3.1.1.2-p3",
      "prefix": "ll: and ",
      "suffix": " cities "
    },
    "source": "Project Gutenberg #10800",
    "text": "Duas civitates duo faciunt amores; Jerusalem facit amor Dei, Babylonem amor saeculi; unusquisque se quid amet interroget, et inveniet unde sit civis."
  },
  "3.1.1.2-r19": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4486,
    "selector": {
      "exact": "Lucian",
      "in": "3.1.1.2-p3",
      "prefix": " words. ",
      "suffix": " to the "
    },
    "source": "Project Gutenberg #10800",
    "text": "Alter mari ortus, ferox, varius, fluctuans, inanis, juvenum, mare referens, &c. Alter aurea catena coelo demissa bonum furorem mentibus mittens, &c."
  },
  "3.1.1.2-r2": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4464,
    "selector": {
