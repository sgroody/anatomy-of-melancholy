    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4477,
    "selector": {
      "exact": "as",
      "in": "3.1.1.2-p3",
      "prefix": "senses; ",
      "suffix": " the spe"
    },
    "source": "Project Gutenberg #10800",
    "text": "Species pulchrituninis hauriuntur oculis, auribus, aut concipiuntur interna mente."
  },
  "3.1.1.2-r12": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4478,
