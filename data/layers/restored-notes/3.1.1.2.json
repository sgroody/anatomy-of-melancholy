      "in": "3.1.1.2-p3",
      "prefix": "eek it. ",
      "suffix": " man lov"
    },
    "source": "Project Gutenberg #10800",
    "text": "Nemo amore capitur nisi qui fuerit ante forma specieque delectatus."
  },
  "3.1.1.2-r8": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 4474,
    "selector": {
      "exact": "Beauty",
      "in": "3.1.1.2-p3",
      "prefix": "nes it, ",
      "suffix": " is a li"
    },
    "source": "Project Gutenberg #10800",
    "text": "Forma est vitalis fulgor ex ipso bono manans per ideas, semina, rationes, umbras effusus, animos excitans ut per bonum in unum redigantur."
  },
  "3.1.1.2-r9": {
    "by": "rules",
