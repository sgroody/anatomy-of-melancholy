      "in": "2.3.3.1-p3",
      "prefix": "honest. ",
      "suffix": " is expo"
    },
    "source": "Project Gutenberg #10800",
    "text": "Omnium oculis, odio, insidiis expositus, semper solicitus, fortunae ludibrium."
  },
