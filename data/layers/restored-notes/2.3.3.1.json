      "in": "2.3.3.1-p17",
      "prefix": "o ruin, ",
      "suffix": " infelic"
    },
    "source": "Project Gutenberg #10800",
    "text": "Guicciard. in Hiponest nulla infelicitas subjectum esse legi naturae &c."
  },
  "2.3.3.1-r12": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3748,
    "selector": {
      "exact": "Madaurensis",
      "in": "2.3.3.1-p19",
      "prefix": ", saith ",
      "suffix": ", whatso"
    },
    "source": "Project Gutenberg #10800",
    "text": "Si recte philosophemini, quicquid aptam moderationem supergreditur, oneri potius quam usui est."
  },
  "2.3.3.1-r14": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3774,
    "selector": {
      "exact": "And",
      "in": "2.3.3.1-p30",
      "prefix": "nd out. ",
      "suffix": " surely "
    },
    "source": "Project Gutenberg #10800",
    "text": "Et certe ille laetabatur, ego anxius; securus ille, ego trepidus. Et si percontaretur me quisquam an exultare mallem, an metuere, responderem, exultare: et si rursus interrogaret an ego talis essem, an qualis nunc sum, me ipsis curis confectum eligerem; sed perversitate, non veritate."
  },
  "2.3.3.1-r15": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3786,
    "selector": {
      "exact": "No",
      "in": "2.3.3.1-p35",
      "prefix": "e said) ",
      "suffix": " man sho"
    },
    "source": "Project Gutenberg #10800",
    "text": "Nemo paupertatem commendaret nisi pauper."
  },
  "2.3.3.1-r16": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3792,
    "selector": {
      "exact": "devil",
      "in": "2.3.3.1-p42",
      "prefix": "ob; the ",
      "suffix": " had his"
    },
    "source": "Project Gutenberg #10800",
    "text": "An quum super fimo sedit Job, an eum omnia abstulit diabolus, &c. pecuniis privatus fiduciam deo habuit, omni thesauro preciosiorem."
  },
  "2.3.3.1-r17": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3793,
    "selector": {
      "exact": "and",
      "in": "2.3.3.1-p42",
      "prefix": "ob did, ",
      "suffix": " be not "
    },
    "source": "Project Gutenberg #10800",
    "text": "Haec videntes sponte philosophemini, nec insipientum affectibus agitemur."
  },
  "2.3.3.1-r19": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3808,
    "selector": {
      "exact": "in",
      "in": "2.3.3.1-p46",
      "prefix": " agony, ",
      "suffix": " temptat"
    },
    "source": "Project Gutenberg #10800",
    "text": "Modo in pressura, in tentationibus, erit postea bonum tuum requies, aeternitas, immortalitas."
  },
  "2.3.3.1-r2": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3685,
    "selector": {
      "exact": "Chrysostom",
      "in": "2.3.3.1-p1",
      "prefix": "ding to ",
      "suffix": ", the se"
    },
    "source": "Project Gutenberg #10800",
    "text": "Divitiarum sequela, luxus, intemperies, arroganta, superbia, furor injustus, omnisque irrationibilis motus."
  },
  "2.3.3.1-r21": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3824,
    "selector": {
      "exact": "is",
      "in": "2.3.3.1-p55",
      "prefix": " holds, ",
      "suffix": " like th"
    },
    "source": "Project Gutenberg #10800",
    "text": "Qualis mundi statis supra lunam semper serenus."
  },
  "2.3.3.1-r22": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3830,
    "selector": {
      "exact": "Epictetus",
      "in": "2.3.3.1-p57",
      "prefix": ", saith ",
      "suffix": ", hath t"
    },
    "source": "Project Gutenberg #10800",
    "text": "Unaquaeque res duas habet ansas, alternam quae teneri, alteram quae non potest; in manu nostra quam volumus accipere."
  },
  "2.3.3.1-r3": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3688,
    "selector": {
      "exact": "you",
      "in": "2.3.3.1-p2",
      "prefix": "riches; ",
      "suffix": " see the"
    },
    "source": "Project Gutenberg #10800",
    "text": "Vos quidem divites putatis felices, sed nescitis eorum miserias."
  },
  "2.3.3.1-r4": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3689,
    "selector": {
      "exact": "and",
      "in": "2.3.3.1-p2",
      "prefix": "ffects; ",
      "suffix": " who can"
    },
    "source": "Project Gutenberg #10800",
    "text": "Et quota pars haec eorum quae istos discruciant? si nossetis metus et curas, quibus obnoxii sunt, plane fugiendas vobis divitias existimaretis."
  },
  "2.3.3.1-r5": {
