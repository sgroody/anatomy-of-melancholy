  "2.3.3.1-r10": {
    "by": "rules",
    "date": "2026-11-18",
    "method": "rules/restore-v2",
    "pg_note": 3729,
    "selector": {
      "exact": "Exigit",
      "in": "2.3.3.1-f55",
      "prefix": "cultu / ",
      "suffix": " innocua"
    },
    "source": "Project Gutenberg #10800",
    "text": "Gyges regno Lydiae inflatus sciscitatum misit Apollinem an quis mortalium se felicior esset. Aglaium Areadum pauperrimum Apollo praetulit, qui terminos agri sui nunquam excesserat, rure suo contentus. Val. lib. 1. c. 7."
  },
  "2.3.3.1-r11": {
