      "in": "3.4.2.6-p4",
      "prefix": "re that ",
      "suffix": " of the "
    },
    "source": "Project Gutenberg #10800",
    "text": "Magnam injuriam Deo facit qui diffidit de ejus misericordia."
  },
  "3.4.2.6-r20": {
    "by": "rules",
    "date": "2026-11-03",
