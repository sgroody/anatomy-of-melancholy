      "prefix": "a Lamb. ",
      "suffix": " gives s"
    },
    "source": "Project Gutenberg #10800",
    "text": "Omnes languores sanat, caecis visum, claudis gressum, gratiam confert, &c."
  },
  "3.4.2.6-r13": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6779,
    "selector": {
      "exact": "Fulgentius",
      "in": "3.4.2.6-p5",
      "prefix": " (saith ",
      "suffix": ") is del"
    },
    "source": "Project Gutenberg #10800",
    "text": "Delectatur Deus conversione peccatoris; omne tempus vitae conversioni deputatur; pro praesentibus habentur tam praeterita quam futura."
  },
  "3.4.2.6-r14": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6781,
    "selector": {
      "exact": "Whatsoever",
      "in": "3.4.2.6-p5",
      "prefix": "Austin, ",
      "suffix": " thou sh"
    },
    "source": "Project Gutenberg #10800",
    "text": "Quicquid feceris, quantumcunque peccaveris, adhuc in vita es, unde te omnino si sanare te nollet Deus, auferret; parcendo clamat ut redeas, &c."
  },
  "3.4.2.6-r15": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6785,
