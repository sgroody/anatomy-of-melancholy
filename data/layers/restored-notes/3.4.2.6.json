      "in": "3.4.2.6-p14",
      "prefix": "cludes, ",
      "suffix": " devil h"
    },
    "source": "Project Gutenberg #10800",
    "text": "Potentior est Deo diabolus et mundi princeps, et in multitudine hominum sita est majestas."
  },
  "3.4.2.6-r18": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6799,
    "selector": {
      "exact": "We",
      "in": "3.4.2.6-p14",
      "prefix": "oceeds, ",
      "suffix": " account"
    },
    "source": "Project Gutenberg #10800",
    "text": "Homicida qui non subvenit quum potest; hoc de Deo sine scelere cogitari non potest, utpote quum quod vult licet. Boni natura communicari. Bonus Deus, quomodo misericordiae, pater, &c."
  },
  "3.4.2.6-r19": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6801,
    "selector": {
      "exact": "Origen",
      "in": "3.4.2.6-p14",
      "prefix": " (saith ",
      "suffix": ") that n"
    },
    "source": "Project Gutenberg #10800",
    "text": "Venia danda est iis qui non audiunt ob ignoratiam. Non est tam iniquus Judex Deus: ut quenquam indicia causa damnare velit. Ii solum damnantur, qui oblatam Christi gratium rejiciunt."
  },
  "3.4.2.6-r2": {
