      "prefix": "nce, as ",
      "suffix": " truly t"
    },
    "source": "Project Gutenberg #10800",
    "text": "Non est poenitentia, sed Dei misericordia annexa."
  },
  "3.4.2.6-r17": {
    "by": "rules",
    "date": "2026-11-03",
    "method": "rules/restore-v1",
    "pg_note": 6798,
    "selector": {
