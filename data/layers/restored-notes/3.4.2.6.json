      "prefix": " Saint. ",
      "suffix": " him tha"
    },
    "source": "Project Gutenberg #10800",
    "text": "Qui turpibus cantilenis aliquando inquinavit os, divinis hymnis animum purgabit."
  },
  "3.4.2.6-r12": {
    "by": "rules",
    "date": "2026-11-03",
