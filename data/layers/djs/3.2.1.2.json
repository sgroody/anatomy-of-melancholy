    "left_anchor": "when they love at last as fresh as they did at first,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": "as Homer brings Paris kissing Helena, after they had been married ten",
    "right_score": 1.0,
    "status": "aligned",
