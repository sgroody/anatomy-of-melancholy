  },
  "3.2.1.2-f43": {
    "align_score": 0.851,
    "by": "djs1927",
    "left_anchor": "is full of men and women’s unsatiable lust, Nero’s, Heliogabali, Bonosi, &c.",
    "left_score": 0.932,
    "method": "rules/djs-align-v3",
    "right_anchor": ". They neigh after other men’s wives (as Jeremy cap. 5. 8",
    "right_score": 0.851,
    "status": "aligned",
