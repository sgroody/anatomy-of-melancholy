    "by": "djs1927",
    "gap_words": 42,
    "left_anchor": "rules her as head, but she again commands his heart, he i",
    "left_score": 0.991,
    "method": "rules/djs-align-v3",
    "right_anchor": "when they love at last as fresh as they did at first,",
