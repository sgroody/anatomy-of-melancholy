  },
  "3.2.1.2-f46": {
    "align_score": 0.882,
    "by": "djs1927",
    "gap_words": 99,
    "left_anchor": "brotherly love in Amnon towards his sister. Human, divine laws, precepts, exhortat",
    "left_score": 0.975,
    "method": "rules/djs-align-v3",
    "right_anchor": "Of women’s unnatural, unsatiable lust, what Country, what Village doth not complain?",
