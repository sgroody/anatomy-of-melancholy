    "align_score": 0.944,
    "by": "djs1927",
    "left_anchor": "is no more love, but burning lust, a disease, Frenzy, Madness, Hell.",
    "left_score": 0.944,
    "method": "rules/djs-align-v3",
    "right_anchor": "; ’tis no virtuous habit this, but a vehement perturbation of the",
    "right_score": 1.0,
    "status": "aligned",
    "text": "'Tis death, 'tis an immedicable calamity, 'tis a raging madness",
