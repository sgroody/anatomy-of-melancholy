  },
  "3.2.1.2-f4": {
    "align_score": 1.0,
    "by": "djs1927",
    "left_anchor": "of nature, wit, and art, as Alexis in Athenaeus sets it out,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": ". It subverts kingdoms, overthrows cities, towns, families, mars, corrupts, and makes",
    "right_score": 1.0,
    "status": "aligned",
