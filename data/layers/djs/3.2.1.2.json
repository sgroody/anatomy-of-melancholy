  "3.2.1.2-f25": {
    "align_score": 0.925,
    "by": "djs1927",
    "gap_words": 5,
    "left_anchor": ", when they live without jarring, scolding, lo",
    "left_score": 0.925,
    "method": "rules/djs-align-v3",
