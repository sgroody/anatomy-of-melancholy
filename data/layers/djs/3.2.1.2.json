  "3.2.1.2-f44": {
    "align_score": 0.893,
    "by": "djs1927",
    "left_anchor": "cap. 5. 8 complaineth) like fed horses, or range like town Bulls,",
    "left_score": 0.893,
    "method": "rules/djs-align-v3",
    "right_anchor": ", as many of our great ones do. Solomon’s wisdom was extinguished",
    "right_score": 1.0,
    "status": "aligned",
