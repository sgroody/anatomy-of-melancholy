  "3.2.1.2-f45": {
    "align_score": 1.0,
    "by": "djs1927",
    "left_anchor": "disgrace, honour cannot oppose, stave off, or withstand the fury of it,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": ". No cord, nor cable can so forcibly draw, or hold so",
    "right_score": 1.0,
    "status": "aligned",
