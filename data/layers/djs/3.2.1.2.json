  "3.2.1.2-f39": {
    "align_score": 0.667,
    "by": "djs1927",
    "left_anchor": "the Jesuit, quaest. 6 in cap. 2 Josue, subscribes. Generally women begin",
    "left_score": 0.667,
    "method": "rules/djs-align-v3",
    "right_anchor": "as they call it, or",
