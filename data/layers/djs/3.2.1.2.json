  "3.2.1.2-f18": {
    "align_score": 0.94,
    "by": "djs1927",
    "left_anchor": ". He is not a man but a block, a very stone,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": ", he hath a gourd for his head, a pepon for his",
