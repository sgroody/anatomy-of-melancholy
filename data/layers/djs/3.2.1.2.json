  },
  "3.2.1.2-f48": {
    "align_score": 1.0,
    "attribution": "euripides",
    "by": "djs1927",
    "left_anchor": "the same man, father and son, master and servant on one woman.",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": "What breach of vows and oaths, fury, dotage, madness, might I reckon",
    "right_score": 1.0,
    "status": "aligned",
    "text": "What have desire and lust unbridled left Chaste and inviolate upon the earth?",
    "text_sha1": "6321409bdc9af0e30d3f80bcc7cf8fc9241dcb70",
    "threshold": 0.85,
    "where": "IA anatomyofmelanch1927burt djvu.txt line 35247, pp. 657-658"
  },
  "3.2.1.2-f49": {
    "align_score": 0.973,
    "attribution": "plautus",
    "by": "djs1927",
    "left_anchor": "can be more absurd? And yet what so common? Who so furious?",
    "left_score": 0.973,
    "method": "rules/djs-align-v3",
    "right_anchor": "some dote then more than ever they did in their youth. How",
    "right_score": 1.0,
