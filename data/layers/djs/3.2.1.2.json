    "text_sha1": "eb327abcfccc23d33cfbb6957aba1b8c4795113c",
    "threshold": 0.85
  },
  "3.2.1.2-f22": {
    "align_score": 0.991,
    "by": "djs1927",
    "left_anchor": "passion, an honest, for men to love in the way of marriage;",
    "left_score": 0.991,
    "method": "rules/djs-align-v3",
    "right_anchor": ". You know marriage is honourable, a blessed calling, appointed by God",
    "right_score": 1.0,
    "status": "aligned",
    "text": "as matter seeks form, so woman man.",
    "text_sha1": "88f2258b02bf212ce7a2a8ec424a402a48f0c80c",
    "threshold": 0.85,
    "where": "IA anatomyofmelanch1927burt djvu.txt line 35073, p. 654"
  },
  "3.2.1.2-f23": {
    "align_score": 1.0,
    "by": "djs1927",
    "left_anchor": "God himself in Paradise, it breeds true peace, tranquillity, content and happiness,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": ", as Daphnaeus in Plutarch could well prove,",
    "right_score": 1.0,
    "status": "aligned",
    "text": "than which no holier union exists or ever did,",
    "text_sha1": "00bced79e356fca20d20ceb098949b144b76c474",
    "threshold": 0.85,
    "where": "IA anatomyofmelanch1927burt djvu.txt line 35076, p. 654"
  },
  "3.2.1.2-f24": {
    "align_score": 0.977,
    "by": "djs1927",
    "left_anchor": ", as Daphnaeus in Plutarch could well prove,",
    "left_score": 1.0,
    "method": "rules/djs-align-v3",
    "right_anchor": ", when they live without jarring, scolding, lovingly as they should do.",
    "right_score": 0.977,
    "status": "aligned",
    "text": "(and which gives immortality to human kind),",
    "text_sha1": "4dd6d7d77ba2aa088a6e61f0f30d9a65bc3543d4",
