    "align_score": 0.982,
    "by": "djs1927",
    "gap_words": 48,
    "left_anchor": "shall scarce find a maid at fourteen years of age, they a",
    "left_score": 0.982,
    "method": "rules/djs-align-v3",
    "right_anchor": "no tongue can sufficiently declare, every story is full of men and",
    "right_score": 1.0,
    "status": "implausible-length",
