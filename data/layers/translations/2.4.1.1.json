    "translations": [
      {
        "by": "machine",
        "confidence": "high",
        "date": "2026-10-27",
        "flags": [],
        "literal": "Surgeon from physician how differs? namely in this, / kills this one with juices, kills that one with hand: / from the executioner in this both only to differ seem, / more slowly these do what does he quickly.",
        "model": "claude-opus-5-5",
        "models_reported": [
          "claude-opus-5-5"
        ],
        "note": "In the preceding sentence Burton introduces this as 'that facete Epigram of Maximilianus Vrientius'. 'Hic' (with potions) is the physician and 'ille' (by hand) the surgeon.",
        "prompt": "tr-v2",
        "self_translation": {
          "burton_span": null,
          "status": "none"
        },
        "source": {
          "author": null,
          "basis": null,
          "locus": null,
          "status": "unidentified",
          "verified": false,
          "work": null
        },
        "text": "How does the surgeon differ from the physician? In this: / the one kills with potions, the other with his hand. / From the hangman both seem to differ only in this, / that they do slowly what he does quickly.",
        "warnings": []
      }
    ]
