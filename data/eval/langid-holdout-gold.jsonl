{"gold": "la", "kind": "phrase", "sid": "h-italic-057", "stratum": "italic", "text": "aut vincetur, aut vincet", "unit": "2.3.2.1"}
{"gold": "name", "kind": null, "sid": "h-italic-058", "stratum": "italic", "text": "Plato", "unit": "3.1.1.1"}
