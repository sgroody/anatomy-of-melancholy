{"gold": "en", "kind": null, "sid": "h-italic-040", "stratum": "italic", "text": "&c", "unit": "1.2.1.2"}
{"gold": "name", "kind": null, "sid": "h-italic-041", "stratum": "italic", "text": "Smindyrides", "unit": "1.2.2.2"}
{"gold": "name", "kind": null, "sid": "h-italic-042", "stratum": "italic", "text": "Democritus", "unit": "2.2.3.1"}
{"gold": "citation", "kind": null, "sid": "h-italic-043", "stratum": "italic", "text": "Salmuth Tit", "unit": "3.2.5.1"}
{"gold": "name", "kind": null, "sid": "h-italic-044", "stratum": "italic", "text": "Melanchthon", "unit": "1.2.2.1"}
{"gold": "en", "kind": null, "sid": "h-italic-045", "stratum": "italic", "text": "Command me what you will, I will do it; bid me go to Sea, I am gone in an instant, take so many stripes, I am ready, run through the fire, and lay down my life and soul at thy feet, ’tis done", "unit": "3.2.3.1"}
{"gold": "name", "kind": null, "sid": "h-italic-046", "stratum": "italic", "text": "Curtius", "unit": "3.3.1.1"}
{"gold": "citation", "kind": null, "sid": "h-italic-047", "stratum": "italic", "text": "88", "unit": "2.2.2.1"}
{"gold": "en", "kind": null, "sid": "h-italic-048", "stratum": "italic", "text": "God is only wise", "unit": "djr"}
{"gold": "citation", "kind": null, "sid": "h-italic-049", "stratum": "italic", "text": "Ecclus", "unit": "1.2.4.7"}
{"gold": "en", "kind": null, "sid": "h-italic-050", "stratum": "italic", "text": "which are enamoured, they can perceive by the bending of boughs, and inclination of their bodies", "unit": "3.2.1.1"}
{"gold": "name", "kind": null, "sid": "h-italic-051", "stratum": "italic", "text": "Menenius Agrippa", "unit": "2.3.3.1"}
