<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema for data/text/<unit>.xml: a small TEI subset plus the ed: namespace for Gowland's
  editorial matter (SPEC §4.1). Validated on every ingest by lxml's RELAX NG.
-->
<grammar xmlns="http://relaxng.org/ns/structure/1.0"
         xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0"
         xmlns:ed="https://burton-edition.local/ns/gowland"
         ns="http://www.tei-c.org/ns/1.0"
         datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">

  <start>
    <element name="TEI">
      <attribute name="xml:lang"><value>en</value></attribute>
      <ref name="teiHeader"/>
      <element name="text"><element name="body"><oneOrMore><ref name="div"/></oneOrMore></element></element>
    </element>
  </start>

  <define name="teiHeader">
    <element name="teiHeader">
      <element name="fileDesc">
        <element name="titleStmt"><element name="title"><text/></element></element>
        <element name="publicationStmt"><element name="p"><text/></element></element>
        <element name="sourceDesc"><element name="p"><text/></element></element>
      </element>
    </element>
  </define>

  <!-- common attributes -->
  <define name="id"><attribute name="xml:id"><data type="ID"/></attribute></define>
  <define name="src"><optional><attribute name="src"/></optional></define>
  <define name="prov">
    <optional><attribute name="resp"><choice>
      <value>#rules</value><value>#editor</value><value>#gowland</value><value>#model</value>
    </choice></attribute></optional>
    <optional><attribute name="cert"><choice><value>high</value><value>medium</value><value>low</value></choice></attribute></optional>
  </define>
  <define name="lang"><attribute name="xml:lang"><data type="language"/></attribute></define>

  <define name="div">
    <element name="div">
      <attribute name="type"><choice><value>subsection</value><value>front</value><value>back</value></choice></attribute>
      <attribute name="n"/>
      <optional><attribute name="resp"><value>#gowland</value></attribute></optional>
      <ref name="id"/>
      <zeroOrMore><ref name="block"/></zeroOrMore>
    </element>
  </define>

  <define name="block">
    <choice>
      <ref name="head"/>
      <ref name="p"/>
      <ref name="lg"/>
      <ref name="quote"/>
      <ref name="list"/>
      <ref name="figure"/>
      <ref name="gowlandBlock"/>
      <element name="ed:endnote">
        <a:documentation>One of Gowland's Explanatory Notes (data/text/gowland-endnotes.xml only).</a:documentation>
        <ref name="id"/>
        <attribute name="n"/>
        <attribute name="src"/>
        <ref name="inline"/>
      </element>
    </choice>
  </define>

  <define name="figure">
    <element name="figure">
      <ref name="src"/>
      <element name="graphic"><attribute name="url"/><empty/></element>
    </element>
  </define>

  <define name="gowlandBlock">
    <element name="ed:block">
      <a:documentation>Unbracketed Gowland translation, marked from data/manual/blocks.yaml.</a:documentation>
      <oneOrMore><ref name="block"/></oneOrMore>
    </element>
  </define>

  <define name="foreignBlockAttrs">
    <optional><ref name="id"/></optional>
    <optional><ref name="lang"/><attribute name="ana"><value>foreign</value></attribute></optional>
  </define>

  <define name="list">
    <element name="list">
      <optional><attribute name="rend"/></optional>
      <ref name="src"/>
      <oneOrMore>
        <element name="item">
          <optional><attribute name="rend"/></optional>
          <ref name="src"/>
          <ref name="inline"/>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="head">
    <element name="head">
      <attribute name="type"><choice>
        <value>partition</value><value>number</value><value>title</value><value>other</value>
      </choice></attribute>
      <optional><attribute name="subtype"/></optional>
      <optional><attribute name="facs"/></optional>
      <ref name="foreignBlockAttrs"/>
      <ref name="src"/><ref name="prov"/>
      <ref name="inline"/>
    </element>
  </define>

  <define name="p">
    <element name="p">
      <ref name="id"/>
      <optional><attribute name="rend"/></optional>
      <ref name="src"/>
      <ref name="inline"/>
    </element>
  </define>

  <define name="quote">
    <element name="quote">
      <attribute name="type"><value>block</value></attribute>
      <ref name="foreignBlockAttrs"/>
      <ref name="src"/><ref name="prov"/>
      <oneOrMore><choice><ref name="lg"/><ref name="p"/><ref name="verseTrans"/><ref name="quote"/></choice></oneOrMore>
    </element>
  </define>

  <define name="lg">
    <element name="lg">
      <ref name="id"/>
      <optional><attribute name="type"><value>translation-block</value></attribute></optional>
      <optional><ref name="lang"/><attribute name="ana"><value>foreign</value></attribute></optional>
      <ref name="src"/><ref name="prov"/>
      <oneOrMore>
        <element name="l">
          <optional><attribute name="rend"/></optional>
          <ref name="src"/>
          <ref name="inline"/>
        </element>
      </oneOrMore>
    </element>
  </define>

  <define name="verseTrans">
    <element name="ed:verse-trans">
      <a:documentation>Gowland's bracketed verse translation (resp=gowland by definition).</a:documentation>
      <optional><attribute name="for"/></optional>
      <optional><attribute name="part"><a:documentation>Piece of one bracket running over several blocks: I(nitial), M(edial), F(inal).</a:documentation><choice><value>I</value><value>M</value><value>F</value></choice></attribute></optional>
      <ref name="lg"/>
    </element>
  </define>

  <define name="inline">
    <zeroOrMore>
      <choice>
        <text/>
        <element name="hi"><attribute name="rend"/><ref name="inline"/></element>
        <element name="foreign">
          <optional><ref name="id"/></optional><ref name="lang"/>
          <optional><attribute name="ana"><value>foreign</value></attribute></optional>
          <optional><attribute name="type"><value>script</value></attribute></optional>
          <ref name="prov"/>
          <ref name="inline"/>
        </element>
        <element name="note">
          <attribute name="type"><value>side</value></attribute>
          <ref name="id"/>
          <attribute name="n"><data type="positiveInteger"/></attribute>
          <attribute name="src"/>
          <attribute name="srcN"><data type="positiveInteger"/></attribute>
          <choice>
            <ref name="inline"/>
            <oneOrMore><ref name="p"/></oneOrMore>
          </choice>
        </element>
        <element name="pb">
          <attribute name="n"/>
          <attribute name="ed"><value>penguin2021</value></attribute>
          <empty/>
        </element>
        <element name="lb"><empty/></element>
        <element name="ed:locs">
          <a:documentation>A run of the Table's page references: Penguin 2021 page numbers (Gowland's matter).</a:documentation>
          <oneOrMore><choice><text/><element name="ed:pageref"><attribute name="n"/><text/></element></choice></oneOrMore>
        </element>
        <element name="supplied">
          <attribute name="resp"><choice><value>#gowland</value><value>#editor</value></choice></attribute>
          <ref name="inline"/>
        </element>
        <element name="choice">
          <element name="sic"><ref name="inline"/></element>
          <element name="corr"><attribute name="resp"><value>#editor</value></attribute><ref name="inline"/></element>
        </element>
        <element name="ref">
          <attribute name="type"><value>xref</value></attribute>
          <optional><attribute name="target"/></optional>
          <ref name="inline"/>
        </element>
        <element name="ed:trans">
          <optional><attribute name="for"/></optional>
        <optional><attribute name="part"><a:documentation>Piece of one bracket running over several blocks: I(nitial), M(edial), F(inal).</a:documentation><choice><value>I</value><value>M</value><value>F</value></choice></attribute></optional>
          <ref name="inline"/>
        </element>
        <element name="ed:enref">
          <attribute name="target"/>
          <attribute name="n"/>
          <optional><attribute name="src"/></optional>
          <optional><attribute name="sic"><a:documentation>EPUB's original (wrong) target, see data/manual/link-fixes.yaml</a:documentation></attribute></optional>
          <empty/>
        </element>
        <element name="g">
          <attribute name="ref"/>
          <empty/>
        </element>
      </choice>
    </zeroOrMore>
  </define>
</grammar>
